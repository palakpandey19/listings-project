<% layout('layouts/boilerplate') -%>
    <h2 class="mb-3">EDIT A NEW LISTING</h2>
    <form action="/listings/<%=listingid._id%>?_method=PUT" method="POST" class="needs-validation" novalidate>
        <div class="row">   
            <div class="col-md-6 mb-3">
                <label for="title" class="form-label">Enter the title:</label>
                <input type="text" name="listing[title]" value="<%=listingid.title%>" id="title" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a title.
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="description" class="form-label">Enter the description:</label>
                <input type="text" name="listing[description]" value="<%=listingid.description%>" id="description" required class="form-control">
                <div class="invalid-feedback">
                    Please provide a description.
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="imageurl" class="form-label">Enter the image URL:</label>
                <input type="text" name="listing[image][url]" value="<%=listingid.image.url%>" id="imageurl" class="form-control">
            </div>
            <div class="col-md-6 mb-3">
                <label for="price" class="form-label">Enter the price:</label>
                <input type="number" name="listing[price]" value="<%=listingid.price%>" id="price" required class="form-control">
                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="location" class="form-label">Enter the location:</label>
                <input type="text" name="listing[country]" value="<%=listingid.country%>" id="location" required class="form-control">
                <div class="invalid-feedback">
                    Please provide the location.
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="country" class="form-label">Enter the country name:</label>
                <input type="text" name="listing[location]" value="<%=listingid.location%>" id="country" required class="form-control">
                <div class="invalid-feedback">
                    Please provide the country name.
                </div>
            </div>
        </div>
        <button class="btn btn-primary listbtn">EDIT</button>
    </form>