<% layout('layouts/boilerplate') -%>
    <h2 class="mb-3"><%=listingid.title%></h2>
    <div class="row">
        <div class="col-md-4">
            <div class="card mb-5">
                <img src="<%=listingid.image.url%>" class="card-img-top listingimg" alt="<%=listingid.image.filename%>">
                <div class="card-body">
                    <h5 class="card-title"><%=listingid.title%></h5>
                    <p class="card-text"><%=listingid.description%></p>
                    <p class="card-text"><%=listingid.location%></p>
                    <p class="card-text"><%=listingid.country%></p>
                    <p class="card-text">&#8377;<%=listingid.price.toLocaleString("en-IN")%></p>
                    <% if(currUser && listingid.owner && currUser._id.equals(listingid.owner._id)){%>
                        <a href="/listings/<%=listingid._id%>/edit" class="btn btn-primary mb-3 listbtn">EDIT THIS LISTING</a>
                        <form action="/listings/<%=listingid._id%>?_method=DELETE" method="POST">
                            <button class="btn btn-primary listbtn">DELETE THIS LISTING</button>
                        </form>
                    <% }%>
                    
                </div>
            </div>
        </div>
    </div>
    

    <%if(currUser){%>
        <h4 class="mb-3">Leave a review</h4>
        <form action="/listings/<%=listingid._id%>/reviews" method="POST" class="needs-validation" novalidate>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="comment" class="form-label">Enter the comment:</label>
                    <input type="text" name="review[comment]" id="comment" class="form-control" required>
                    <div class="invalid-feedback">
                        Please provide your valuable feedback.
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="rating" class="form-label">Enter the Rating:</label> 
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />

                        <input type="radio" id="rate1" name="review[rating]" value="1" />
                        <label for="rate1">1 star.</label>

                        <input type="radio" id="rate2" name="review[rating]" value="2" />
                        <label for="rate2">2 stars.</label>

                        <input type="radio" id="rate3" name="review[rating]" value="3" />
                        <label for="rate3">3 stars.</label>

                        <input type="radio" id="rate4" name="review[rating]" value="4" />
                        <label for="rate4">4 stars.</label>

                        <input type="radio" id="rate5" name="review[rating]" value="5" />
                        <label for="rate5">5 stars.</label>

                        <span class="starability-focus-ring"></span>
                    </fieldset>  
                </div>
            </div>
            <button class="btn btn-primary listbtn mb-5">ADD A REVIEW</button>
        </form>
    <%}%>
    
    <%if(listingid.reviews.length>0){%>
        <h4 class="mb-3">All reviews</h4>
        <div class="row">
            <%for(review of listingid.reviews){%>
                <div class="col-md-4 col-sm-6">
                    <div class="card mb-5">
                        <div class="card-body">
                            <h5 class="card-title"><%=review.author.username%></h5>
                            <p class="card-text"><%=review.comment%></p>
                            
                            <p class="starability-result card-text" data-rating="<%=review.rating%>">
                                Rated: <%=review.rating%> stars
                            </p>
                            <form action="/listings/<%=listingid._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                                <button class="btn btn-primary listbtn">DELETE</button>
                            </form>
                        </div>
                    </div>
                </div>
            <%}%>
        </div>
    <%}%>

    <div class="row">
        <div class="container">
            <div class="col-md-6 mb-5">
                <h4 class="mb-3">Where you'll be</h4>
                <div id="map"></div>
            </div>
        </div>
        
    </div>

    <script>
        let mapapi = "<%=process.env.MAP_API%>";
        const coordinate = JSON.parse('<%- JSON.stringify(listingid.geometry.coordinates) %>');
        const map = new mapboxgl.Map({
            accessToken: mapapi,
            container: 'map', // container ID
            center: coordinate, // starting position [lng, lat]. Note that lat must be set between -90 and 90
            zoom: 9 // starting zoom
        });
        console.log(coordinate);
        const marker1 = new mapboxgl.Marker()
        .setLngLat(coordinate)
        .addTo(map);
    </script>
    
    
    
    
    
